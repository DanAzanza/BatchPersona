# BatchPersona Environment Configuration
# Copy this file to .env or export these variables in your terminal

# ComfyUI Server Address (host:port)
# Desktop typically runs on 127.0.0.1:8000, while portable/git ComfyUI runs on 127.0.0.1:8188
COMFYUI_SERVER=127.0.0.1:8000

# Execution timeout per individual asset (in seconds)
TIMEOUT_SECONDS=300.0

# Optional market tag prefix for generated asset filenames (apac, latam, emea, global)
MARKET_TAG=apac
